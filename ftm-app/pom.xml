<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0-M4</version>
        <relativePath/>
    </parent>

    <groupId>com.ftm</groupId>
    <artifactId>ftm-app</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ftm-app</name>
    <description>Follow the Money — modular monolith</description>

    <properties>
        <java.version>25</java.version>
        <springdoc.version>2.8.8</springdoc.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <spring-retry.version>2.0.12</spring-retry.version>
        <!-- Spring AI BOM version — verify against Spring Boot parent compatibility -->
        <spring-ai.version>1.0.0</spring-ai.version>
        <!-- JaCoCo 0.8.12 does not support Java 25 class files; skip report until JaCoCo supports it -->
        <jacoco.skip>true</jacoco.skip>
        <commons-csv.version>1.14.0</commons-csv.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ── Web + REST ──────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ── Data / ORM ──────────────────────────────────────────── -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── Flyway ──────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Spring Boot 4: Flyway auto-configuration moved to its own module -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- ── jOOQ ───────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>

        <!-- ── Cache (Caffeine) ────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- ── HTTP client (Yahoo Finance + FRED) ─────────────────── -->
        <!-- RestClient is part of spring-boot-starter-web (Spring Boot 3.2+) -->
        <!-- spring-retry for @Retryable on client calls; aspectjweaver required for proxy-based retry -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
            <version>${spring-retry.version}</version>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- ── Validation ─────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ── MapStruct (DTO ↔ Entity mapping) ───────────────────── -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- ── Apache Commons (csc read) ──────────────────────────── -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>

        <!--
        ── Spring AI — add in EP-003 once correct artifact name confirmed.
           Check: https://docs.spring.io/spring-ai/reference/getting-started.html
           Likely: spring-ai-starter-model-anthropic (Spring AI 1.0+)
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-anthropic-spring-boot-starter</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        -->

        <!-- ── Docker Compose auto-start (dev only) ─────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── Test ────────────────────────────────────────────────── -->
        <!-- MockWebServer for RestClient unit tests (no Spring context needed) -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Instancio: random but valid test-object generation for Java records and POJOs -->
        <dependency>
            <groupId>org.instancio</groupId>
            <artifactId>instancio-core</artifactId>
            <version>5.4.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.instancio</groupId>
            <artifactId>instancio-junit</artifactId>
            <version>5.4.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- `mvn spring-boot:run` activates the 'local' Spring profile by default so
                         application-local.yml (FRED key, etc.) is loaded without extra flags. -->
                    <profiles>local</profiles>
                </configuration>
            </plugin>
            <!--
                Flyway migrates the local PostgreSQL schema BEFORE jOOQ codegen and tests so
                neither step needs Docker/Testcontainers. Requires a local PostgreSQL on
                localhost:5432 with databases `ftm` (codegen) and `ftm_test` (isolated tests):
                    docker compose up -d postgres   # or any local PostgreSQL
                For a Docker-based, zero-local-DB build instead, use `-Ptestcontainers`.
            -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>${flyway.version}</version>
                <configuration>
                    <url>jdbc:postgresql://localhost:5432/ftm</url>
                    <user>ftm</user>
                    <password>ftm</password>
                    <locations>filesystem:src/main/resources/db/migration</locations>
                </configuration>
                <executions>
                    <!-- Migrate the codegen DB so jOOQ introspects the fully-migrated schema -->
                    <execution>
                        <id>flyway-migrate-for-codegen</id>
                        <phase>initialize</phase>
                        <goals><goal>migrate</goal></goals>
                    </execution>
                    <!-- Migrate the isolated test DB so tests run against a clean schema -->
                    <execution>
                        <id>flyway-migrate-test-db</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>migrate</goal></goals>
                        <configuration>
                            <url>jdbc:postgresql://localhost:5432/ftm_test</url>
                            <user>ftm</user>
                            <password>ftm</password>
                            <locations>filesystem:src/main/resources/db/migration</locations>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>42.7.4</version>
                    </dependency>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>${flyway.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- Always register jOOQ generated sources so -Djooq.codegen.skip=true still compiles -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-jooq-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/jooq</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <executions>
                    <execution>
                        <id>jooq-codegen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>42.7.4</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- Direct JDBC to local PostgreSQL — no Docker. Override with -Ptestcontainers. -->
                    <jdbc>
                        <driver>org.postgresql.Driver</driver>
                        <url>jdbc:postgresql://localhost:5432/ftm</url>
                        <user>ftm</user>
                        <password>ftm</password>
                    </jdbc>
                    <generator>
                        <database>
                            <name>org.jooq.meta.jdbc.JDBCDatabase</name>
                            <includes>.*</includes>
                            <inputSchema>public</inputSchema>
                        </database>
                        <generate>
                            <records>true</records>
                            <daos>false</daos>
                            <pojos>false</pojos>
                        </generate>
                        <target>
                            <packageName>com.ftm.app.jooq</packageName>
                            <directory>target/generated-sources/jooq</directory>
                        </target>
                    </generator>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- Tests run against the isolated local `ftm_test` DB (no Docker).
                         Override with -Ptestcontainers to use an ephemeral Docker PostgreSQL. -->
                    <systemPropertyVariables>
                        <spring.datasource.url>jdbc:postgresql://localhost:5432/ftm_test</spring.datasource.url>
                        <spring.datasource.driver-class-name>org.postgresql.Driver</spring.datasource.driver-class-name>
                        <spring.datasource.username>ftm</spring.datasource.username>
                        <spring.datasource.password>ftm</spring.datasource.password>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.spotify.fmt</groupId>
                <artifactId>fmt-maven-plugin</artifactId>
                <version>2.29</version>
                <dependencies>
                    <!-- Override bundled version: 1.28.0 adds Java 25 support -->
                    <dependency>
                        <groupId>com.google.googlejavaformat</groupId>
                        <artifactId>google-java-format</artifactId>
                        <version>1.28.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!--
        Build profiles.

        DEFAULT (no profile): Docker-free. jOOQ codegen and tests connect directly to a local
        PostgreSQL on localhost:5432 (databases `ftm` and `ftm_test`). Flyway migrates both before
        codegen/tests. This is the everyday local + CI path:
            mvn test
            mvn spring-boot:run          # auto-activates the 'local' Spring profile

        testcontainers: opt-in for contributors WITHOUT a local PostgreSQL. Restores the original
        Docker/Testcontainers path — an ephemeral PostgreSQL is spun up for both codegen and tests:
            mvn test -Ptestcontainers

        local-pg: retained as a no-op alias so existing `-Plocal-pg` invocations keep working;
        its configuration is now the default.
    -->
    <profiles>
        <profile>
            <id>local-pg</id>
        </profile>
        <profile>
            <id>testcontainers</id>
            <build>
                <plugins>
                    <!-- Codegen needs no local DB: spin up an ephemeral PostgreSQL via Testcontainers -->
                    <plugin>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq-codegen-maven</artifactId>
                        <configuration>
                            <jdbc>
                                <driver>org.testcontainers.jdbc.ContainerDatabaseDriver</driver>
                                <url>jdbc:tc:postgresql:16-alpine:///codegen?TC_INITSCRIPT=file:src/main/resources/db/codegen/codegen_schema.sql</url>
                                <user>test</user>
                                <password>test</password>
                            </jdbc>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.postgresql</groupId>
                                <artifactId>postgresql</artifactId>
                                <version>42.7.4</version>
                            </dependency>
                            <dependency>
                                <groupId>org.testcontainers</groupId>
                                <artifactId>jdbc</artifactId>
                                <version>${testcontainers.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.testcontainers</groupId>
                                <artifactId>postgresql</artifactId>
                                <version>${testcontainers.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>junit</groupId>
                                <artifactId>junit</artifactId>
                                <version>4.13.2</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                    <!-- No local DB to migrate: disable the default Flyway executions -->
                    <plugin>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>flyway-migrate-for-codegen</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>flyway-migrate-test-db</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Tests use the Testcontainers JDBC URL from application-test.yml -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <spring.datasource.url>jdbc:tc:postgresql:16:///ftm</spring.datasource.url>
                                <spring.datasource.driver-class-name>org.testcontainers.jdbc.ContainerDatabaseDriver</spring.datasource.driver-class-name>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
